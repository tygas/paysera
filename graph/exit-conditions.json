  "data_retention": {
    "$comment": "G1 decides the period and the owner; both are [TBD] until it runs. Tracked here because nothing in the graph executed the deletion G1 authorises the research on.",
    "retention_days": "[TBD — G1]",
    "deletion_owner": "[TBD — G1]",
    "deletion_due": "[TBD — prep_start_date + retention_days]",
    "deletion_executed": { "met": false, "executed_by": null, "executed_at": null, "substitute_allowed": false },
    "covers_loops": ["loop_a", "loop_d", "loop_e"]
  },

  "global_constraints": {
    "critical_path": "loop_b.legal_basis_review (G1) → loop_a + loop_d → loop_b.map_to_pilot_scope (G2) → loop_e → G3 review → CEO",
    "shortest_possible_prep_duration_days": 27,
    "$comment_on_duration": "27 days to the CEO decision, 30 to a launch-ready state. v1.0 claimed a 19-day shortest path, which was only achievable by running personal-data collection before the legal basis existed.",
    "behind_schedule_rule": "The response to being behind is a later date or a narrower scope. Never a skipped review, a skipped consent, or a bypassed gate.",
    "daily_sync_recommended": true
  }
