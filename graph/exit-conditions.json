  "loop_a": {
    "name": "Domain Expert Interviews",
    "status": "blocked_by_gate",
    "gated_by": ["G1"],
    "depends_on_loops": [],
    "start_day": 7,
    "end_day": 20,
    "agents": {
      "find_contacts":      { "start_day": 7,  "end_day": 9,  "status": "blocked_by_gate" },
      "schedule_calls":     { "start_day": 9,  "end_day": 12, "status": "blocked_by_gate" },
      "conduct_interviews": { "start_day": 12, "end_day": 18, "status": "blocked_by_gate" },
      "extract_insights":   { "start_day": 18, "end_day": 20, "status": "blocked_by_gate" }
    },
    "metrics": {
      "contacts_identified":     { "direction": "higher_better", "minimum": 15, "target": 20, "stretch": 30, "current": 0, "status": "not_started" },
      "interviews_completed":    { "direction": "higher_better", "minimum": 10, "target": 12, "stretch": 15, "current": 0, "status": "not_started" },
      "interview_minutes":       { "direction": "higher_better", "minimum": 30, "target": 45, "stretch": 60, "current": null, "status": "not_started" },
      "topics_per_interview":    { "direction": "higher_better", "minimum": 4,  "target": 5,  "stretch": 6,  "current": 0, "status": "not_started" },
      "transcript_accuracy_pct": { "direction": "higher_better", "minimum": 80, "target": 95, "stretch": 100, "current": null, "status": "not_started" },
      "theme_saturation":        { "direction": "binary", "definition": "No new themes appeared in the last 3 consecutive interviews.", "required_for_target": true, "current": false, "status": "not_started" }
    },
    "binary_requirements": {
      "recording_consent_before_recording": { "met": null, "substitute_allowed": false }
    },
    "incentive_eur": 20,
    "outputs": [
      "graph/output/loop-a/contacts.csv",
      "graph/output/loop-a/call_schedule.json",
      "graph/output/loop-a/transcripts/",
      "graph/output/loop-a/insights.json"
    ],
    "escalation": {
      "p12_under_8_confirmed": "Broaden channels and time. Do not raise the incentive.",
      "p15_under_8_completed": "Switch to the 30-minute format; prioritise sellers over buyers.",
      "p18_under_10_completed": "Loop-A ends P22, Loop-E starts P23, CEO decision P29. Review is not compressed."
    }
  },

