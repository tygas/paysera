  "loop_c": {
    "name": "Photo-to-Listing Workflow",
    "status": "not_started",
    "gated_by": [],
    "depends_on_loops": [],
    "start_day": 1,
    "end_day": 15,
    "agents": {
      "collect_test_photos":     { "start_day": 1,  "end_day": 3,  "status": "not_started" },
      "run_photo_to_listing_ai": { "start_day": 4,  "end_day": 12, "status": "not_started" },
      "quality_check_outputs":   { "start_day": 13, "end_day": 15, "status": "not_started" }
    },
    "metrics": {
      "test_photos":         { "direction": "higher_better", "minimum": 8, "target": 10, "stretch": 12, "current": 0, "status": "not_started" },
      "photos_with_output":  { "direction": "higher_better", "minimum": 8, "target": 10, "stretch": 12, "current": 0, "status": "not_started" },
      "prompt_versions":     { "direction": "higher_better", "minimum": 2, "target": 3,  "stretch": 3,  "current": 0, "status": "not_started" },
      "quality_score_of_10": { "direction": "higher_better", "minimum": 6, "target": 7,  "stretch": 8,  "current": null, "status": "not_started" },
      "hallucination_rate_pct": { "direction": "lower_better", "maximum": 5, "target": 0, "stretch": 0, "current": null, "status": "not_started",
        "definition": "Share of generated listings containing a specification the device does not have, measured against the human ground truth recorded before the run. Above 5% Loop-C has FAILED — this is a fail threshold, not a note." },
      "prompt_version_selected": { "direction": "binary", "definition": "One prompt version recommended, with the numbers and the sample-size caveat behind it.", "current": false, "status": "not_started" }
    },
    "binary_requirements": {
      "blind_review":            { "met": null, "substitute_allowed": false },
      "ground_truth_before_run": { "met": null, "substitute_allowed": false }
    },
    "outputs": [
      "graph/output/loop-c/photos/",
      "graph/output/loop-c/photo_index.csv",
      "graph/output/loop-c/ai_outputs.json",
      "graph/output/loop-c/quality_report.md",
      "graph/output/loop-c/prompt_selection.json"
    ],
    "escalation": {
      "p8_under_8_photos": "Add synthetic photos. Not marketplace listing photos.",
      "p12_under_8_reviews": "Focus on 8; document edge cases.",
      "p15_quality_under_6": "Not a reason to extend. Record the result and carry it into the brief as 'workflow did not reach pilot quality'.",
