    "escalation": {
      "p4_no_g1_meeting": "Escalate to CEO the same day. G1 blocks two of four loops.",
      "p6_g1_not_closed": "Loops A and D do not start. Schedule slips day-for-day. Loop-C continues.",
      "p12_under_10_rules": "Narrow the pilot scope rather than skip rules.",
      "p15_g2_not_closed": "Brief marked 'scope unconfirmed'; open items on page 1; pilot does not launch."
