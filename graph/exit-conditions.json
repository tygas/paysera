  "milestones": [
    { "day": 3,  "id": "compliance_docs_extracted", "label": "Compliance documents extracted", "done": false },
    { "day": 6,  "id": "gate_g1",                   "label": "GATE G1 — lawful basis in writing", "done": false },
    { "day": 15, "id": "gate_g2",                   "label": "GATE G2 — scope signed; Loops B and C complete", "done": false },
    { "day": 20, "id": "research_complete",         "label": "Loops A and D complete", "done": false },
    { "day": 25, "id": "brief_drafted",             "label": "Pilot brief drafted", "done": false },
    { "day": 26, "id": "gate_g3",                   "label": "GATE G3 — CTO + Legal review recorded; brief approved for presentation", "done": false },
