    },
    "outputs": [
      "graph/output/loop-b/compliance_extracts.json",
      "graph/output/loop-b/legal_basis_decision.md",
      "graph/output/loop-b/legal_consultation_notes.md",
      "graph/output/loop-b/pilot_checklist.json",
      "graph/output/loop-b/legal_sign_off.eml"
